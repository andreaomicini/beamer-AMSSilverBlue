%% The AMSSilverBlue palette, recovered from AMSCesenaBleu: each colour carries
%% its provenance beside it. Roles and contrasts: README.md.

\mode<presentation>

%% base colours
\definecolor{sbblue}{HTML}{0073BA}         % French Blue, frenchblue in AMSCesenaBleu
\definecolor{sbbluedark}{HTML}{00568C}     % frenchblue!75!black, Bleu bibliography note
\definecolor{sbbluedeep}{HTML}{003F66}     % frenchblue!55!black, Bleu block title
\definecolor{sbbluelight}{HTML}{B2D5EA}    % frenchblue!30!white, Bleu example block title
\definecolor{sbbluetint}{HTML}{EBF4F9}     % frenchblue!8!white, between Bleu block bodies (4%) and AMSUniBo tints
\definecolor{sbblack}{HTML}{000000}        % black
\definecolor{sbtext}{HTML}{000C13}         % frenchblue!10!black, Bleu normal text
\definecolor{sbsilver}{HTML}{B3B3B3}       % gray!60!white, beamer beaver frame title right
\definecolor{sbsilvertint}{HTML}{F2F2F2}   % gray!10!white, beaver frame title
\definecolor{sbsilvertint2}{HTML}{D9D9D9}  % gray!30!white, beaver palette primary
\definecolor{sbgrey}{HTML}{404040}         % darkgray, Bleu quote
\definecolor{sbgreymid}{HTML}{5A5A5A}      % gray!70!black, guessed: secondary text
\definecolor{sbgreyline}{HTML}{BFBFBF}     % lightgray, Bleu \cccite and \uuurl
\definecolor{sbgreybg}{HTML}{ECECEC}       % gray!15!white, beaver palette secondary
\definecolor{sbbluefill}{HTML}{DEEDF6}     % derived as amsredfill from amsred (13%)
\definecolor{sbblueborder}{HTML}{B5D6EB}   % derived as amsredborder (29%)
\definecolor{sbsilverfill}{HTML}{F1F1F1}   % silver!18!white, derived as amsgreenfill from amsgreen (18%)
\definecolor{sbsilverborder}{HTML}{DCDCDC} % silver!46!white, derived as amsgreenborder (46%)
\definecolor{sbwhite}{HTML}{FFFFFF}
\definecolor{basecolour}{HTML}{0073BA} % blue

%% blue is the identity colour, deep blue and silver the structural one
\setbeamercolor{structure}{fg=sbbluedeep}
\setbeamercolor{section in toc}{fg=sbbluedeep,bg=sbwhite}
\setbeamercolor{alerted text}{fg=sbblue}

%% palettes, light to loud; quaternary carries the identity bar
\setbeamercolor*{palette primary}{fg=sbgreymid,bg=sbsilvertint}
\setbeamercolor*{palette secondary}{fg=sbtext,bg=sbsilvertint2}
\setbeamercolor*{palette tertiary}{fg=sbwhite,bg=sbbluedeep}
\setbeamercolor*{palette quaternary}{fg=sbwhite,bg=sbblue}

\setbeamercolor*{sidebar}{fg=sbbluedeep,bg=sbsilvertint}
\setbeamercolor*{palette sidebar primary}{fg=sbtext}
\setbeamercolor*{palette sidebar secondary}{fg=sbgreymid}
\setbeamercolor*{palette sidebar tertiary}{fg=sbbluedeep}
\setbeamercolor*{palette sidebar quaternary}{fg=sbwhite}

%% title and frame title
\setbeamercolor{titlelike}{parent=palette primary,fg=sbblack}
\setbeamercolor{frametitle}{fg=sbblack,bg=sbsilvertint}
\setbeamercolor{frametitle right}{bg=sbsilvertint2}

%% rules
\setbeamercolor*{separation line}{fg=sbsilver}
\setbeamercolor*{fine separation line}{fg=sbgreyline}

\mode
<all>
